# Web Service Configuration
GRPC_PORT=50051
APP_PORT=9000

# Redis Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (CHANGE THESE IN PRODUCTION - min 32 chars)
