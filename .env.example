REFRESH_SECRET=dev-refresh-secret-change-me-32-characters

# Database Configuration
DB_USER=identity
DB_SECRET=dev-password-change-me
DB_HOST=postgres
DB_PORT=5432
DB_NAME=identity
DB_SSLMODE=disable

# Production Flags (optional)
GIN_MODE=